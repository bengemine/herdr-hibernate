UUID_RE = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"

# Per-agent adapters — herdr's `agent` value -> how to measure idle time, find
# the process, and resume a killed session. Only agents listed here are ever
# hibernated: killing anything without a proven resume path would lose the
# conversation, so unknown agents are exempt.
#
#   transcript_glob  where the session's on-disk transcript lives ({sid} = the
#                    id Herdr reports in agent_session.value)
#   bin              executable name; used to spot the agent among the pane's
#                    foreground processes (argv[0] or argv[1] basename, so a
#                    `node .../bin/codex` wrapper matches too)
#   resume_argv      command that resumes session {sid} (run in the pane's cwd)
#   session_in_args  regex whose group(1) is the session id when it appears in
#                    a running process's args (resumed sessions only)
#   helper_tokens    cmdline substrings marking helper processes to ignore
#   replay_flags     flags captured from the killed process's argv and appended
#                    to resume_argv, so a resume keeps e.g. the model override
#   activity_globs   extra files whose timestamped writes count as session
#                    activity even though the main transcript is untouched
AGENTS = {
    "claude": {
        "transcript_glob": os.path.expanduser("~/.claude/projects/*/{sid}.jsonl"),
        # An orchestrator with background sub-agents (Agent tool / workflows)
        # sits at its prompt while the workers append here — the main jsonl
        # goes stale even though the session is mid-flight. Counting these
        # keeps a watching orchestrator from ever classifying as idle.
        "activity_globs": (
            os.path.expanduser("~/.claude/projects/*/{sid}/subagents/*.jsonl"),),
        "bin": "claude",
        "resume_argv": ["claude", "--resume", "{sid}"],
        "session_in_args": r"--resume\s+(%s)" % UUID_RE,
        "helper_tokens": ("bg-pty-host", "bg-spare", " daemon "),
        "replay_flags": (),
    },
    "codex": {
        # rollout-<local-timestamp>-<uuid>.jsonl, nested by year/month/day.
        # `codex resume` appends to this same file and keeps the same id, so
        # the mapping is stable across any number of hibernate/resume cycles.
        "transcript_glob": os.path.expanduser(
            "~/.codex/sessions/*/*/*/rollout-*-{sid}.jsonl"),
        "bin": "codex",
        "resume_argv": ["codex", "resume", "{sid}"],
        "session_in_args": r"resume\s+(%s)" % UUID_RE,
        "helper_tokens": (),
        # Flags that must survive a resume: config overrides, model/profile
        # choices, and — important for safety — sandbox/approval settings and
        # working roots, so a resumed session is never LESS restricted than
        # the one that was killed. Anything unlisted is dropped (a stray
        # positional would become a prompt!).
        "replay_flags": ("-c", "-m", "--model", "-p", "--profile",
                         "-s", "--sandbox", "-a", "--ask-for-approval",
                         "-C", "--cd", "--add-dir"),
        "replay_bool_flags": ("--oss",),
    },
    "grok": {
        # xAI Grok Build. The session dir is named by the session uuid, nested
        # under a percent-encoded copy of the session's cwd.
        "transcript_glob": os.path.expanduser("~/.grok/sessions/*/{sid}/*.jsonl"),
        "bin": "grok",
        # Session ids are global across cwds, but --cwd sidesteps a legacy
        # duplicate-id edge case in grok's sandbox-profile lookup.
        "resume_argv": ["grok", "--resume", "{sid}", "--cwd", "{cwd}"],
        "session_in_args": r"--resume\s+(%s)" % UUID_RE,
        "helper_tokens": (),
        "replay_flags": (),
        # grok transcripts stamp entries with epoch integers, not ISO strings.
        # Only enabled here: a numeric "timestamp" inside claude/codex tool
        # output must not be mistaken for an entry timestamp.
        "epoch_ts": True,
    },
}

