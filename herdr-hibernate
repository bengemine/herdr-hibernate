# ---------------------------------------------------------------- utilities

_log_max_bytes = 512 * 1024  # updated from LOG_MAX_KB by load_config()


def rotate_log():
    """Keep the log bounded: one rotation, so it never exceeds 2x the limit."""
    if _log_max_bytes <= 0:
        return
    try:
        if os.path.getsize(LOG_FILE) > _log_max_bytes:
            os.replace(LOG_FILE, LOG_FILE + ".1")
    except OSError:
        pass


def log(msg, echo=True):
    line = "%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    rotate_log()
    with open(LOG_FILE, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    if echo:
        print(line, flush=True)


def load_config():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
            fh.write(DEFAULT_CONFIG)
        log("created default config at %s (DRY_RUN=1)" % CONFIG_FILE)
    cfg = dict(DEFAULTS)
    with open(CONFIG_FILE, encoding="utf-8") as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            key = key.strip()
            val = val.strip()
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            cfg[key] = val

    # An upgrade can add keys; append the missing ones (with their comments) so
    # the file stays a complete, editable record of what is tunable.
    with open(CONFIG_FILE, encoding="utf-8") as fh:
        body = fh.read()
    missing = ["\n%s%s=%s\n" % ("".join("# %s\n" % c for c in comment.split("\n")),
                                key, val)
               for key, val, comment in CONFIG_KEYS
               if not re.search(r"^\s*%s\s*=" % re.escape(key), body, re.M)]
    if missing:
        with open(CONFIG_FILE, "a", encoding="utf-8") as fh:
            fh.write("".join(missing))

    global _log_max_bytes
    try:
        _log_max_bytes = int(float(cfg["LOG_MAX_KB"]) * 1024)
    except (ValueError, KeyError):
        pass
    return cfg


_herdr_bin = None


def herdr_bin():
    """Absolute path to the herdr CLI.

    A `type = "shell"` keybinding is spawned by the Herdr server with a bare
    PATH that need not include ~/.local/bin, so relying on PATH makes the tool
    die with FileNotFoundError where nobody can see it.
    """
    global _herdr_bin
    if _herdr_bin:
        return _herdr_bin
    injected = os.environ.get("HERDR_BIN_PATH")
    if injected and os.access(injected, os.X_OK):
        _herdr_bin = injected
        return _herdr_bin
    found = shutil.which("herdr")
    if not found:
        for cand in ("~/.local/bin/herdr", "/usr/local/bin/herdr",
                     "/usr/bin/herdr", "/opt/herdr/bin/herdr"):
            cand = os.path.expanduser(cand)
            if os.access(cand, os.X_OK):
                found = cand
                break
    _herdr_bin = found or "herdr"
    return _herdr_bin


def herdr(*args):
    """Run a herdr CLI command, return the parsed `result` object."""
    try:
        out = subprocess.run(
            [herdr_bin(), *args], capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise RuntimeError("cannot run herdr (%s): %s" % (herdr_bin(), exc))
    if out.returncode != 0:
        raise RuntimeError("herdr %s failed: %s" % (" ".join(args), out.stderr.strip()))
    try:
        return json.loads(out.stdout)["result"]
    except (ValueError, KeyError):
        # Some commands (e.g. `pane run`) print nothing / non-JSON on success.
        return {}


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = "%s.tmp.%d" % (STATE_FILE, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, indent=2)
        os.replace(tmp, STATE_FILE)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


@contextlib.contextmanager
def file_lock(path, blocking=True):
    """Hold an advisory process lock. Yield False when a nonblocking lock is busy."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fh = open(path, "a+")
    flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
    try:
        try:
            fcntl.flock(fh.fileno(), flags)
        except BlockingIOError:
            fh.close()
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    finally:
        if not fh.closed:
            fh.close()


def watcher_lock_active():
    """True when another process holds the watcher singleton lock."""
    with file_lock(WATCH_LOCK_FILE, blocking=False) as acquired:
        return not acquired


def run_locked(func, *args, **kwargs):
    """Serialize every state-changing one-shot operation."""
    with file_lock(OPERATION_LOCK_FILE):
        return func(*args, **kwargs)


TS_RE = re.compile(rb'"timestamp"\s*:\s*"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)')
TS_EPOCH_RE = re.compile(rb'"timestamp"\s*:\s*(\d{9,12})\b')  # grok: epoch ints
TAIL_BYTES = 2 * 1024 * 1024


def _stamp_epochs(chunk, allow_epoch=False):
    """All parseable entry timestamps in a transcript chunk, as epoch seconds."""
    out = []
    for iso in TS_RE.findall(chunk):
        try:
            out.append(calendar.timegm(
                time.strptime(iso.decode("ascii", "ignore"),
                              "%Y-%m-%dT%H:%M:%S")))
        except ValueError:
            pass
    if allow_epoch:
        for num in TS_EPOCH_RE.findall(chunk):
            val = int(num)
            if 1_000_000_000 <= val <= 4_102_444_800:  # sane range: 2001..2100
                out.append(val)
    return out


def last_entry_epoch(path, allow_epoch=False):
    """Epoch of the newest timestamped entry in a transcript, or None.

    The file's mtime is NOT a usable idle signal: Claude Code keeps rewriting
    bookkeeping lines (e.g. `last-prompt`, which carries no timestamp) long
    after the conversation goes quiet, so a 3-day-old session can show an mtime
    of seconds ago. Only entries that carry their own timestamp mark real
    activity, so read those.
    """
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > TAIL_BYTES:
                fh.seek(size - TAIL_BYTES)
            stamps = _stamp_epochs(fh.read(), allow_epoch)
            if not stamps and size > TAIL_BYTES:  # rare: no stamps in the tail
                fh.seek(0)
                stamps = _stamp_epochs(fh.read(), allow_epoch)
    except OSError:
        return None
    return max(stamps) if stamps else None


def transcript_age_minutes(uuid, agent="claude"):
    """Minutes since this session's last real activity, or None if no transcript.

    Activity is the newest stamped entry across the main transcript AND the
    agent's activity_globs (e.g. claude sub-agent transcripts): an orchestrator
    whose background workers are still writing is active, not idle.
    """
    spec = AGENTS.get(agent)
    if spec is None:
        return None
    patterns = (spec["transcript_glob"],) + tuple(spec.get("activity_globs", ()))
    paths = [p for pat in patterns for p in glob.glob(pat.format(sid=uuid))]
    if not glob.glob(spec["transcript_glob"].format(sid=uuid)):
        return None  # resumability needs the MAIN transcript, whatever else exists
    newest = None
    for path in paths:
        stamp = last_entry_epoch(path, spec.get("epoch_ts", False))
        if stamp is None:  # unreadable/unstamped — fall back to the file clock
            try:
                stamp = os.stat(path).st_mtime
            except OSError:
                continue
        if newest is None or stamp > newest:
            newest = stamp
    if newest is None:
        return None
    return max(0.0, (time.time() - newest) / 60.0)


def ps_snapshot():
    """{pid: (ppid, rss_kb, args)} for all processes."""
    out = subprocess.run(
        ["ps", "-eo", "pid=,ppid=,rss=,args="], capture_output=True, text=True
    ).stdout
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        try:
            procs[int(parts[0])] = (int(parts[1]), int(parts[2]), parts[3])
        except ValueError:
            continue
    return procs


def proc_uptime_minutes(pid):
    """Minutes since a process started, or None if it cannot be read."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            fields = fh.read().rpartition(b")")[2].split()
        starttime_ticks = int(fields[19])  # field 22, 1-based, after comm
        with open("/proc/uptime") as fh:
            uptime = float(fh.read().split()[0])
    except (OSError, IndexError, ValueError):
        return None
    ticks = os.sysconf("SC_CLK_TCK") or 100
    return max(0.0, (uptime - starttime_ticks / ticks) / 60.0)


def descendants(root, procs):
    kids = {}
    for pid, (ppid, _, _) in procs.items():
        kids.setdefault(ppid, []).append(pid)
    result, stack = [], [root]
    while stack:
        pid = stack.pop()
        for child in kids.get(pid, []):
            result.append(child)
            stack.append(child)
    return result


def tree_rss_mb(root, procs):
    pids = [root] + descendants(root, procs)
    return sum(procs[p][1] for p in pids if p in procs) // 1024


def own_ancestors():
    """PIDs of this process and all its ancestors (never kill these)."""
    procs = ps_snapshot()
    out, pid = set(), os.getpid()
    while pid and pid in procs:
        out.add(pid)
        pid = procs[pid][0]
    return out


def fmt_idle(minutes):
    if minutes is None:
        return "?"
    minutes = int(minutes)
    if minutes < 60:
        return "%dm" % minutes
    hours, mins = divmod(minutes, 60)
    if hours < 48:
        return "%dh%02dm" % (hours, mins)
    return "%dd%02dh" % divmod(hours, 24)


# ------------------------------------------------------------- herdr state

def collect_panes():
    """All panes across all workspaces + tab label map."""
    panes, tab_labels = [], {}
    for ws in herdr("workspace", "list")["workspaces"]:
        ws_id = ws["workspace_id"]
        for tab in herdr("tab", "list", "--workspace", ws_id)["tabs"]:
            tab_labels[tab["tab_id"]] = tab.get("label", "")
        panes.extend(herdr("pane", "list", "--workspace", ws_id)["panes"])
    return panes, tab_labels


def session_uuid(pane):
    sess = pane.get("agent_session")
    if isinstance(sess, dict) and sess.get("value"):
        return sess["value"]
    if pane.get("agent") == "grok":
        return grok_session_id(pane)
    return None


def grok_session_id(pane):
    """Recover a grok pane's session id from grok's own registry.

    Herdr has no grok integration, so agent_session is never populated. Grok
    itself records {session_id, pid, cwd} per live session; match the pane's
    grok process pid against it (pid alone could be recycled, so cwd must
    agree too). A crashed session can leave a stale entry behind — matching
    against the pane's CURRENT foreground pids filters those out.
    """
    info = pane_process_info(pane["pane_id"])
    if not info:
        return None
    pids = {p.get("pid") for p in info.get("foreground_processes") or []
            if p.get("pid") and _matches_agent(p, "grok")}
    if not pids:
        return None
    try:
        with open(os.path.expanduser("~/.grok/active_sessions.json"),
                  encoding="utf-8") as fh:
            entries = json.load(fh)
    except (OSError, ValueError):
        return None
    for entry in entries if isinstance(entries, list) else []:
        if entry.get("pid") not in pids or entry.get("cwd") != pane.get("cwd"):
            continue
        # pid+cwd can BOTH repeat if the OS recycled the pid for a new grok in
        # the same directory. A legit entry is written at process launch, so
        # its opened_at must sit near the live process's start time.
        opened, up = entry.get("opened_at"), proc_uptime_minutes(entry["pid"])
        if opened and up is not None:
            try:
                opened_epoch = calendar.timegm(
                    time.strptime(opened, "%Y-%m-%dT%H:%M:%SZ"))
                if abs((time.time() - up * 60) - opened_epoch) > 600:
                    continue  # stale entry from a dead session; pid recycled
            except ValueError:
                pass  # unparseable opened_at — don't reject on formatting
        return entry.get("session_id")
    return None


_INTERPRETERS = ("node", "bun", "deno", "python", "python3")


def _matches_agent(p, bin_name):
    if p.get("name") == bin_name:
        return True
    argv = p.get("argv") or []
    if not argv:
        return False
    if os.path.basename(argv[0]) in (bin_name, bin_name + ".js"):
        return True
    # An interpreter wrapper (`node .../bin/codex ...`) puts the agent's name
    # second — but ONLY behind a known interpreter, or `vim codex` matches too.
    return (len(argv) > 1
            and os.path.basename(argv[0]) in _INTERPRETERS
            and os.path.basename(argv[1]) in (bin_name, bin_name + ".js"))


def find_agent_proc(pane_id, uuid, agent):
    """The root process of a pane's agent, from herdr's process info.

    Returns (pid, proc-dict) or (None, reason).
    """
    spec = AGENTS.get(agent)
    if spec is None:
        return None, "unsupported agent %s" % agent
    info = pane_process_info(pane_id)
    if not info:
        return None, "no process info for pane"
    procs = info.get("foreground_processes") or []
    found = [p for p in procs if _matches_agent(p, spec["bin"])]
    # Ignore helper processes that are not an interactive session.
    found = [
        p for p in found
        if not any(tok in p.get("cmdline", "")
                   for tok in spec["helper_tokens"])
    ]
    if not found:
        return None, "no %s process in pane foreground" % agent
    if uuid:
        matched = [p for p in found if uuid in p.get("cmdline", "")]
        if matched:
            found = matched
        else:
            # A freshly started agent carries no session id in args; accept it
            # only if it names no OTHER session id.
            for p in found:
                other = re.search(spec["session_in_args"], p.get("cmdline", ""))
                if other and other.group(1) != uuid:
                    return None, "pane %s runs a different session (%s)" % (
                        agent, other.group(1))
    if len(found) > 1:
        # A wrapper and its child both match (node shim + vendored codex
        # binary). Collapse to the wrapper ONLY for that exact shape: two
        # processes, direct parent/child, same arguments after the agent name.
        # Anything else (e.g. a nested second session) is refused — collapsing
        # there would kill a session the tool has no record for.
        def _tail(p):
            argv = p.get("argv") or []
            for i, tok in enumerate(argv):
                if os.path.basename(tok) in (spec["bin"], spec["bin"] + ".js"):
                    return argv[i + 1:]
            return None

        collapsed = None
        if len(found) == 2 and all(p.get("pid") for p in found):
            procs_all = ps_snapshot()
            a, b = found
            for parent, child in ((a, b), (b, a)):
                direct = procs_all.get(child["pid"], (None,))[0] == parent["pid"]
                if direct and _tail(parent) == _tail(child) is not None:
                    collapsed = parent
                    break
        if collapsed is None:
            return None, "multiple %s processes in pane; refusing to guess" % agent
        found = [collapsed]
    if not found[0].get("pid"):
        return None, "pane process info carries no pid"
    return found[0]["pid"], found[0]


def busy_background_job(pane_id, uuid, agent, cfg):
    """Cmdline of a live background job the agent spawned, or None.

    An idle agent's children normally all date from session startup (MCP
    servers, helpers). A descendant that appeared BUSY_CHILD_MINUTES or more
    after the agent root started is work the agent launched and is still
    waiting on — a background monitor, `herdr wait`, a build. The pane only
    LOOKS idle; killing it would orphan that work and lose the wake-up, so
    such a pane is never hibernated automatically.
    """
    late = float(cfg["BUSY_CHILD_MINUTES"])
    if late <= 0:
        return None
    pid, _proc = find_agent_proc(pane_id, uuid, agent)
    if pid is None:
        return None
    root_up = proc_uptime_minutes(pid)
    if root_up is None:
        return None
    ignore = [t.strip().lower() for t in cfg["BUSY_IGNORE_TOKENS"].split()]
    ignore += [t.strip().lower() for t in AGENTS[agent]["helper_tokens"]]
    ignore = [t for t in ignore if t]
    procs = ps_snapshot()
    kids = descendants(pid, procs)
    # An agent can re-exec its own binary mid-session (codex's node wrapper
    # relaunches the vendored TUI on an in-place resume). Those processes
    # carry the pane's session id in their argv: they ARE the agent, not
    # background work — and helpers spawned right after them are startup
    # children of that re-exec, so the "late" clock runs from the youngest
    # such process, not from the original wrapper.
    epoch_up = root_up
    for child in kids:
        if uuid and uuid in procs.get(child, (0, 0, ""))[2]:
            up = proc_uptime_minutes(child)
            if up is not None:
                epoch_up = min(epoch_up, up)
    for child in kids:
        args = procs.get(child, (0, 0, ""))[2]
        if uuid and uuid in args:
            continue  # the agent's own (re-exec'd) session process
        if any(tok in args.lower() for tok in ignore):
            continue
        child_up = proc_uptime_minutes(child)
        if child_up is None:  # already gone — transient, not a background job
            continue
        if epoch_up - child_up >= late:
            return args[:60]
    return None


# ------------------------------------------------------------ classification

def classify(pane, tab_labels, cfg, state, self_pane):
    """-> (decision, reason). decision: hibernate | exempt | skip"""
    pane_id = pane["pane_id"]
    tab_id = pane.get("tab_id", "")
    label = tab_labels.get(tab_id, "") or pane.get("label", "")

    if pane_id in state:
        return "skip", "hibernated (stub waiting for Enter)"
    if pane_id == self_pane:
        return "exempt", "reaper's own pane"
    agent = pane.get("agent")
    if not agent:
        return "skip", "no agent in pane"
    if agent not in AGENTS:
        return "exempt", "agent %s has no proven resume path" % agent

    status = pane.get("agent_status", "unknown")
    if status in ("working", "blocked"):
        return "exempt", "status %s" % status

    pinned_tabs = cfg["PINNED_TABS"].split()
    marker = cfg["PIN_MARKER"]
    if tab_id in pinned_tabs:
        return "exempt", "pinned via PINNED_TABS"
    if marker and (marker in (tab_labels.get(tab_id, "") or "")
                   or marker in (pane.get("label") or "")):
        return "exempt", "pinned via %s label marker" % marker

    if status not in ("idle", "done"):
        return "skip", "status %s (need idle/done)" % status

    uuid = session_uuid(pane)
    if not uuid:
        return "skip", "no session uuid — could not resume, never killing"
    if not re.fullmatch(UUID_RE, uuid):
        # `codex resume` also accepts session NAMES; a non-uuid could silently
        # resolve to a different session. Only kill what we can name exactly.
        return "skip", "session id %r is not a uuid — never killing" % uuid[:40]

    age = transcript_age_minutes(uuid, agent)
    if age is None:
        return "skip", "no transcript file found for %s — cannot verify/resume" % uuid
    threshold = float(cfg["HIBERNATE_AFTER_MINUTES"])
    if age < threshold:
        return "skip", "idle only %s (< %sm threshold)" % (fmt_idle(age), int(threshold))

    # Last (it costs a process-info call): an "idle" agent that spawned a
    # still-running background job is watching something, not idle.
    job = busy_background_job(pane_id, uuid, agent, cfg)
    if job:
        return "skip", "busy: background job running (%s)" % job

    return "hibernate", "idle %s" % fmt_idle(age)


# -------------------------------------------------------------- hibernation

def kill_tree(root, grace_seconds, protected, bin_name):
    """SIGTERM the whole tree rooted at `root`, SIGKILL survivors."""
    procs = ps_snapshot()
    if root not in procs:
        return False, "process %d already gone" % root
    if root in protected or root == 1:
        return False, "refusing to kill protected pid %d" % root
    if bin_name not in procs[root][2]:
        return False, "pid %d is not a %s process (%s)" % (
            root, bin_name, procs[root][2][:60])
    targets = [root] + descendants(root, procs)
    if protected & set(targets):
        return False, "own process inside kill tree; aborting"
    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.time() + grace_seconds
    while time.time() < deadline:
        if not any(os.path.exists("/proc/%d" % p) for p in targets):
            break
        time.sleep(0.25)
    for pid in targets:
        if os.path.exists("/proc/%d" % pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
    return True, "%d processes" % len(targets)


STUB_TEMPLATE = """\
#!/usr/bin/env bash
# herdr-hibernate stub for pane {pane_id} — session {uuid}
# Auto-generated. Deleting this file only disables auto-resume for that pane.
# Herdr lists a pane in its agent panel only while the foreground process is an
# agent. HERDR_AGENT makes Herdr treat this stub as {agent}, so the hibernated
# session stays in the panel. The stub runs as a child of the pane's shell, so
# this exec replaces only the stub itself.
if [ "${{HERDR_AGENT:-}}" != {agent} ]; then
    HERDR_AGENT={agent} _HB_AGENT_HINT=1 exec bash "$0"
fi
shopt -s execfail
_hb_reset_terminal() {{
    stty sane 2>/dev/null || true
    # Interactive agents can leave these emulator modes enabled when killed.
    # Focus reporting is what prints ^[[I/^[[O when Snipping Tool changes focus.
    printf '\\033[?1004l\\033[?2004l\\033[?1000l\\033[?1002l\\033[?1003l\\033[?1006l'
}}
# This script must always run as a CHILD of the pane's shell, never replace it
# (no `exec bash <this>`). claude then ends up a child too, so killing claude at
# the next hibernation leaves the pane's shell alive. If claude were the pane
# shell itself, killing it would close the whole tab.
_hb_bye() {{
    _hb_reset_terminal
    printf '\\n\\033[1;31m%s\\033[0m\\n' 'hibernation stub dismissed.'
    printf 'resume this session by hand with:  %s\\n\\n' {resume_display}
    exit 0
}}
trap _hb_bye INT
_hb_stub() {{
    export HERDR_HIBERNATE_STUB=1
    _hb_reset_terminal
    # The pane's terminal title names its row in Herdr's agent panel.
    printf '\033]2;%s\007' {title}
    cd {cwd} 2>/dev/null || cd "$HOME" || return 0
    printf '\\n\\033[1;35m%s\\033[0m\\n' {banner}
    printf '\\033[2m%s\\033[0m\\n\\n' {subtitle}
    IFS= read -r _ || return 0
    printf 'resuming session %s (takes 10-20s)...\\n' {uuid}
    {tool} label-awake {pane_id} >/dev/null 2>&1
    # The hint was for the stub; the resumed agent is detected by its own name.
    if [ -n "${{_HB_AGENT_HINT:-}}" ]; then
        unset HERDR_AGENT _HB_AGENT_HINT
    fi
    # NOTE: the record and this script are deliberately NOT deleted here. The
    # reaper clears them once it sees the agent actually live in the pane, so a
    # failed resume (or a Herdr restart mid-resume) still leaves the pane armed.
    exec {resume_cmd}
}}
_hb_stub
_hb_bye
"""


def pane_file(pane_id):
    """Path of the durable stub script for a pane (must match the .bashrc hook)."""
    return os.path.join(PANES_DIR, re.sub(r"[^A-Za-z0-9]", "_", pane_id) + ".sh")


def since_minutes(at):
    """Minutes since a 'YYYY-mm-dd HH:MM:SS' timestamp, or None if unparseable."""
    try:
        return (time.time() - time.mktime(
            time.strptime(at, "%Y-%m-%d %H:%M:%S"))) / 60.0
    except (ValueError, TypeError):
        return None


def since_str(at):
    """Human age of a 'YYYY-mm-dd HH:MM:SS' timestamp."""
    mins = since_minutes(at)
    return "?" if mins is None else fmt_idle(mins)


def resume_argv(rec):
    """The argv that resumes a record's session, e.g. ['codex', 'resume', <id>].

    Prefers the argv captured at hibernation time (which carries replayed
    flags); falls back to the adapter template for records written by older
    versions, which were always Claude.
    """
    saved = rec.get("resume")
    if isinstance(saved, list) and saved:
        return saved
    agent = rec.get("agent", "claude")
    spec = AGENTS.get(agent)
    if spec is None:
        # Record from a newer version (or foreign data): never guess a resume
        # command for an unknown agent — surface the id instead.
        return ["echo", "cannot auto-resume unknown agent %r — session %s"
                % (agent, rec.get("uuid"))]
    cwd = rec.get("cwd") or os.path.expanduser("~")
    return [tok.format(sid=rec["uuid"], cwd=cwd) for tok in spec["resume_argv"]]


def stub_title(rec):
    """Terminal title of a waiting stub: the session's own title, asleep."""
    title = rec.get("title") or rec.get("label") or rec.get("uuid", "")
    title = re.sub(r"[\x00-\x1f\x7f]", "", title).strip()
    return ("💤 %s" % title)[:80]


def write_stub_file(pane_id, rec):
    """(Re)write the pane's stub script from its state record. Returns its path."""
    os.makedirs(PANES_DIR, exist_ok=True)
    banner = "💤 hibernated %s ago (freed ~%dMB) — press Enter to resume" % (
        since_str(rec.get("at", "")), rec.get("freed_mb", 0))
    subtitle = "session %s · %s · Ctrl-C for a plain shell" % (
        rec["uuid"], rec.get("cwd", ""))
    resume = resume_argv(rec)
    path = pane_file(pane_id)
    body = STUB_TEMPLATE.format(
        pane_id=shlex.quote(pane_id),
        uuid=shlex.quote(rec["uuid"]),
        resume_cmd=" ".join(shlex.quote(t) for t in resume),
        resume_display=shlex.quote(" ".join(shlex.quote(t) for t in resume)),
        cwd=shlex.quote(rec.get("cwd") or os.path.expanduser("~")),
        banner=shlex.quote(banner),
        subtitle=shlex.quote(subtitle),
        tool=shlex.quote(SELF),
        agent=shlex.quote(rec.get("agent", "claude")),
        title=shlex.quote(stub_title(rec)),
    )
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.chmod(tmp, 0o755)
    os.replace(tmp, path)
    return path


def remove_stub_file(pane_id):
    try:
        os.remove(pane_file(pane_id))
    except OSError:
        pass


def resume_stamp_path(pane_id):
    """Marker written the moment a pane's stub fires, beside its stub script."""
    return pane_file(pane_id)[:-len(".sh")] + ".resumed"


def write_resume_stamp(pane_id):
    os.makedirs(PANES_DIR, exist_ok=True)
    with open(resume_stamp_path(pane_id), "w") as fh:
        fh.write(time.strftime("%Y-%m-%d %H:%M:%S"))


def resume_stamp_minutes(pane_id):
    """Minutes since this pane's stub last fired, or None if it never did."""
    try:
        with open(resume_stamp_path(pane_id)) as fh:
            return since_minutes(fh.read().strip())
    except OSError:
        return None


def remove_resume_stamp(pane_id):
    try:
        os.remove(resume_stamp_path(pane_id))
    except OSError:
        pass


def agent_age_minutes(pid, pane_id):
    """Minutes the pane's agent has really been running, or None if unknown.

    The process start time alone lies after a resume: the stub `exec`s the
    agent, and exec keeps the stub's own start time — a stub that waited three
    days makes a ten-second-old claude look three days old. The stub stamps
    the pane when it fires (via `label-awake`), so the younger of the two
    clocks is the truth. A stamp older than the process belongs to an earlier
    resume and loses.
    """
    ages = [a for a in (proc_uptime_minutes(pid), resume_stamp_minutes(pane_id))
            if a is not None]
    return min(ages) if ages else None


def stub_command(pane_id):
    """Command that arms the pane's stub as a CHILD of the pane shell.

    Never `exec` here: the pane's own shell has to outlive both the stub and
    the claude it resumes, otherwise the next hibernation closes the tab.
    """
    # Reset before starting the script as well as inside it. This closes the
    # normal post-kill window where Codex or Grok can leave focus reporting on.
    return ("stty sane 2>/dev/null || true; "
            "printf '\\033[?1004l\\033[?2004l\\033[?1000l\\033[?1002l"
            "\\033[?1003l\\033[?1006l'; bash %s"
            % shlex.quote(pane_file(pane_id)))


def pane_process_info(pane_id):
    try:
        return herdr("pane", "process-info", "--pane", pane_id)["process_info"]
    except (RuntimeError, KeyError, TypeError):
        return None


# "hibernate-stub" is the arg0 of stubs planted by versions before stub files
# existed; those are still valid waiting stubs and must not be double-planted.
STUB_MARKERS = (PANES_DIR, "hibernate-stub")


def stub_alive(info):
    """True if this pane's foreground process is a herdr-hibernate stub."""
    if not info:
        return False
    return any(any(m in (p.get("cmdline") or "") for m in STUB_MARKERS)
               for p in info.get("foreground_processes") or [])


def bare_shell(info):
    """True if the pane sits at an idle shell prompt with nothing running.

    Deliberately strict: the single foreground process must be the shell itself
    with no arguments, so a pane running `bash -c ...` is never mistaken for an
    empty prompt and never has a stub typed into it.
    """
    if not info:
        return False
    procs = info.get("foreground_processes") or []
    if len(procs) != 1:
        return False
    proc = procs[0]
    if proc.get("name") not in ("bash", "sh", "zsh", "fish", "dash"):
        return False
    argv = proc.get("argv") or []
    return len(argv) <= 1 and proc.get("pid") == info.get("shell_pid")


def toast(title, body="", sound="none"):
    """Best-effort Herdr notification — the only feedback a keybinding can give."""
    args = ["notification", "show", title, "--position", "top-right",
            "--sound", sound]
    if body:
        args += ["--body", body]
    try:
        herdr(*args)
    except (RuntimeError, OSError):
        pass


PANEL_SOURCE = "bengemine.hibernate"


def mark_hibernated(pane_id, agent):
    """Show a hibernated pane as "hibernated" in Herdr's agent panel.

    The stub keeps the pane in the panel as `agent` (see STUB_TEMPLATE); this
    replaces its idle/done status text. Herdr keeps the label until it is
    cleared, applied only while the pane's agent is `agent`. `unknown` covers
    the moment before Herdr has classified the stub.
    """
    try:
        herdr("pane", "report-metadata", pane_id, "--source", PANEL_SOURCE,
              "--agent", agent, "--state-label", "idle=hibernated",
              "--state-label", "done=hibernated",
              "--state-label", "unknown=hibernated")
    except RuntimeError:
        pass


def mark_when_listed(pane_id, agent, timeout=5.0):
    """Label a freshly armed stub once Herdr lists it as `agent`.

    A label reported earlier belongs to the agent that was just killed, and
    Herdr drops it when the stub takes the pane. The watcher re-labels waiting
    stubs on every pass, so a stub still unlisted at the timeout is labelled
    then.
    """
    deadline = time.time() + timeout
    while True:
        try:
            pane = herdr("pane", "get", pane_id).get("pane", {})
        except RuntimeError:
            return
        if pane.get("agent") == agent and stub_alive(pane_process_info(pane_id)):
            mark_hibernated(pane_id, agent)
            return
        if time.time() >= deadline:
            return
        time.sleep(0.25)


def clear_hibernated(pane_id):
    """Drop the "hibernated" label, so the resumed agent shows its own status."""
    try:
        herdr("pane", "report-metadata", pane_id, "--source", PANEL_SOURCE,
              "--clear-state-labels")
    except RuntimeError:
        pass


def build_resume(agent, sid, proc, cwd):
    """Resume argv for a session, with whitelisted flags replayed from the
    process being killed (so e.g. a codex model override survives resume)."""
    spec = AGENTS[agent]
    base = [tok.format(sid=sid, cwd=cwd) for tok in spec["resume_argv"]]
    keep = spec["replay_flags"]
    argv = (proc or {}).get("argv") or []
    if not keep or not argv:
        return base
    start = 0
    for i, tok in enumerate(argv):
        if os.path.basename(tok) in (spec["bin"], spec["bin"] + ".js"):
            start = i + 1
            break
    bools = spec.get("replay_bool_flags", ())
    tail, extra, i = argv[start:], [], 0
    while i < len(tail):
        tok = tail[i]
        if tok in keep and i + 1 < len(tail):
            extra += [tok, tail[i + 1]]
            i += 2
        elif "=" in tok and tok.split("=", 1)[0] in keep:  # --model=x form
            extra.append(tok)
            i += 1
        elif tok in bools:
            extra.append(tok)
            i += 1
        else:
            i += 1
    return base + extra


def record_marked_label(rec):
    """The exact label this record owns, including backward compatibility."""
    if rec.get("marker_added") is False:
        return None
    marked = rec.get("marked_label")
    if marked:
        return marked
    label = rec.get("label", "")
    if label and not label.startswith("💤"):
        return "💤 %s" % label
    return None


def marker_record(label, tab_id, state):
    """Return (original, marked, added) for a new hibernation record."""
    for rec in state.values():
        if rec.get("tab_id") != tab_id:
            continue
        marked = record_marked_label(rec)
        if marked and label == marked:
            return rec.get("label", label), marked, True
    if label and not label.startswith("💤"):
        return label, "💤 %s" % label, True
    return label, None, False


def restore_owned_tab_label(pane_id, pane, rec, state):
    """Restore our exact tab marker. False means retry before deleting the record."""
    marked = record_marked_label(rec)
    if not marked:
        return True
    tab_id = pane.get("tab_id") or rec.get("tab_id", "")
    if not tab_id:
        return False
    if any(other_id != pane_id
           and other.get("tab_id") == tab_id
           and record_marked_label(other) == marked
           for other_id, other in state.items()):
        return True  # another pane in this tab is still hibernated
    try:
        current = herdr("tab", "get", tab_id).get("tab", {}).get("label", "")
    except RuntimeError as exc:
        log("LABEL retry %s (%s): %s" % (rec.get("label", "?"), pane_id, exc),
            echo=False)
        return False
    if current != marked:
        return True  # the user changed it, or this marker is not ours
    try:
        herdr("tab", "rename", tab_id, rec.get("label", ""))
    except RuntimeError as exc:
        log("LABEL retry %s (%s): %s" % (rec.get("label", "?"), pane_id, exc),
            echo=False)
        return False
    return True


def hibernate_pane(pane, tab_labels, cfg, state, idle_str, dry_run, force=False):
    pane_id = pane["pane_id"]
    tab_id = pane.get("tab_id", "")
    label = tab_labels.get(tab_id, "") or pane.get("label", "") or pane_id
    uuid = session_uuid(pane)
    agent = pane.get("agent")
    if agent not in AGENTS:
        log("SKIP %s (%s): agent %s has no proven resume path" % (
            label, pane_id, agent))
        return False
    # classify() proved a session id earlier, but for grok it is re-resolved
    # live (registry lookup) and could have vanished in between. A kill with
    # no resumable id must never happen, whatever the caller checked.
    if not uuid or not re.fullmatch(UUID_RE, uuid):
        log("SKIP %s (%s): no valid session id at kill time — never killing"
            % (label, pane_id))
        return False

    pid, proc = find_agent_proc(pane_id, uuid, agent)
    if pid is None:
        log("SKIP %s (%s): %s" % (label, pane_id, proc))
        return False

    # Killing the pane's own shell closes the tab. That is never acceptable —
    # it can happen if the agent replaced the shell (an `exec claude` stub).
    info = pane_process_info(pane_id)
    if info and pid == info.get("shell_pid"):
        log("SKIP %s (%s): %s is the pane's shell — killing it would close "
            "the tab" % (label, pane_id, agent))
        return False

    # A session resumed a moment ago still has an old last-message timestamp
    # (loading history writes nothing), so it looks ancient. It cannot be idler
    # than its own process is old — measured by agent_age_minutes, because the
    # raw process start time is the stub's after an exec.
    up = agent_age_minutes(pid, pane_id)
    threshold = float(cfg["HIBERNATE_AFTER_MINUTES"])
    if not force and up is not None and up < threshold:
        log("SKIP %s (%s): %s only started %s ago (likely just resumed)" % (
            label, pane_id, agent, fmt_idle(up)))
        return False

    rss_mb = tree_rss_mb(pid, ps_snapshot())

    if dry_run:
        log("WOULD hibernate %s (%s, idle %s, ~%dMB, pid %d)" % (
            label, pane_id, idle_str, rss_mb, pid))
        return False

    # Re-verify status just before killing — it may have started working.
    fresh = herdr("pane", "get", pane_id).get("pane", {})
    if fresh.get("agent_status") not in ("idle", "done"):
        log("ABORT %s (%s): status changed to %s" % (
            label, pane_id, fresh.get("agent_status")))
        return False

    ok, detail = kill_tree(pid, float(cfg["KILL_GRACE_SECONDS"]),
                           own_ancestors(), AGENTS[agent]["bin"])
    if not ok:
        log("ABORT %s (%s): %s" % (label, pane_id, detail))
        return False

    time.sleep(1.0)  # let the pane shell come back to its prompt
    remove_resume_stamp(pane_id)  # the next stub writes a fresh one
    cwd = pane.get("cwd") or os.path.expanduser("~")
    original_label, marked_label, marker_added = marker_record(label, tab_id, state)
    rec = {
        "uuid": uuid, "agent": agent,
        "resume": build_resume(agent, uuid, proc, cwd),
        "tab_id": tab_id, "label": original_label, "cwd": cwd,
        "title": pane.get("terminal_title_stripped") or "",
        "marker_added": marker_added, "marked_label": marked_label,
        "freed_mb": rss_mb, "at": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    # Record + stub file first: if anything below fails, the .bashrc hook and
    # `restore` can still bring this pane back.
    state[pane_id] = rec
    save_state(state)
    write_stub_file(pane_id, rec)
    herdr("pane", "run", pane_id, stub_command(pane_id))
    mark_when_listed(pane_id, agent)
    try:
        if marked_label and label != marked_label:
            herdr("tab", "rename", tab_id, marked_label)
    except RuntimeError:
        pass
    log("HIBERNATED %s (%s, idle %s, freed ~%dMB, killed tree of pid %d [%s])" % (
        label, pane_id, idle_str, rss_mb, pid, detail))
    return True


def forget_record(pane_id, state, why):
    """Erase everything this tool knows about a pane. Nothing is archived.

    Deliberately no graveyard file: once a tab is gone, its session id, label
    and cwd leave the tool entirely. The transcript itself is Claude Code's
    own data under ~/.claude/projects and is never touched here.
    """
    rec = state.pop(pane_id, None)
    save_state(state)
    remove_stub_file(pane_id)
    remove_resume_stamp(pane_id)
    log("FORGOT %s (%s): %s" % (rec.get("label", "?") if rec else "?",
                                pane_id, why))


def gc_stub_files(state, panes=None):
    """Delete stub scripts that no longer belong to a tracked pane.

    Resume stamps outlive their record on purpose (the record goes the moment
    the agent is seen live; the stamp must still guard that agent), so they are
    only dropped once their pane is gone — and only when a pane list is given.
    """
    expected = {os.path.basename(pane_file(p)) for p in state}
    live_stamps = None
    if panes is not None:
        live_stamps = {os.path.basename(resume_stamp_path(p["pane_id"]))
                       for p in panes}
    try:
        names = os.listdir(PANES_DIR)
    except OSError:
        return
    for name in names:
        if name.endswith(".sh") and name not in expected:
            try:
                os.remove(os.path.join(PANES_DIR, name))
                log("GC stub script %s (no matching pane record)" % name,
                    echo=False)
            except OSError:
                pass
        elif (name.endswith(".resumed") and live_stamps is not None
              and name not in live_stamps):
            try:
                os.remove(os.path.join(PANES_DIR, name))
            except OSError:
                pass


def match_pane(pane_id, rec, panes):
    """Find the pane a record belongs to, tolerating id churn across restarts."""
    by_id = {p["pane_id"]: p for p in panes}
    if pane_id in by_id:
        return by_id[pane_id]
    # Herdr can renumber panes across restarts: fall back to the tab, then to
    # the tab label we stamped with 💤 plus the recorded cwd.
    for pane in panes:
        if rec.get("tab_id") and pane.get("tab_id") == rec["tab_id"]:
            return pane
    for pane in panes:
        if (not pane.get("agent") and rec.get("cwd")
                and pane.get("cwd") == rec["cwd"]
                and (pane.get("label") or "").lstrip("💤 ") == rec.get("label")):
            return pane
    return None


def restore_records(panes, tab_labels, state, dry_run=False, forget_after=15.0):
    """Re-arm hibernated panes whose stub died (Herdr restart / reboot / kill).

    This is what makes hibernation survive a machine restart: the stub is just
    a process, so it dies with Herdr — but the state record and the pane's stub
    script both live on disk, so the pane can always be re-armed.
    """
    restored = 0
    for pane_id in list(state):
        rec = state[pane_id]
        label = rec.get("label", "?")
        pane = match_pane(pane_id, rec, panes)
        if pane is None:
            # Tab closed -> forget it completely. The grace window exists only
            # so a half-started Herdr (incomplete pane list) cannot erase tabs
            # that are actually still open.
            gone_for = since_minutes(rec.get("missing_since"))
            if dry_run:
                log("WOULD forget %s (%s): pane gone%s" % (
                    label, pane_id,
                    "" if gone_for is None else " for %s" % fmt_idle(gone_for)))
            elif forget_after <= 0 or (gone_for is not None
                                       and gone_for >= forget_after):
                forget_record(pane_id, state, "tab closed")
            elif gone_for is None:
                rec["missing_since"] = time.strftime("%Y-%m-%d %H:%M:%S")
                save_state(state)
                log("MISSING %s (%s): pane gone — forgetting in %dm unless it "
                    "comes back" % (label, pane_id, forget_after), echo=False)
            continue
        if rec.pop("missing_since", None) is not None:
            save_state(state)  # pane came back — cancel the pending forget
        if transcript_age_minutes(rec["uuid"], rec.get("agent", "claude")) is None:
            # No transcript means nothing to resume — the record is dead weight.
            if not dry_run:
                forget_record(pane_id, state, "session transcript is gone")
            continue

        live_id = pane["pane_id"]
        if live_id != pane_id and not dry_run:  # pane renumbered — re-key it
            log("REKEY %s: %s -> %s" % (label, pane_id, live_id))
            remove_stub_file(pane_id)
            del state[pane_id]
            rec["tab_id"] = pane.get("tab_id", rec.get("tab_id", ""))
            state[live_id] = rec
            save_state(state)
            pane_id = live_id

        info = pane_process_info(pane_id)
        if stub_alive(info):
            # Healthy: a stub is sitting there waiting for Enter. Still make
            # sure its script exists on disk, so the .bashrc hook can re-arm
            # the pane by itself after the next reboot.
            # Rewriting is safe while the stub runs: write_stub_file replaces
            # the file atomically, so the running bash keeps its old inode.
            if not dry_run:
                fresh = not os.path.exists(pane_file(pane_id))
                write_stub_file(pane_id, rec)
                mark_hibernated(pane_id, rec.get("agent", "claude"))
                if fresh:
                    log("ARMED %s (%s): wrote stub script for reboot recovery"
                        % (label, pane_id), echo=False)
            continue
        if pane.get("agent") == rec.get("agent", "claude"):
            # The agent is live in the pane again — the stub did its job.
            # (Accept any session uuid: right after a resume Herdr may not have
            # picked the session identity up yet.)
            if not dry_run:
                if not restore_owned_tab_label(pane_id, pane, rec, state):
                    continue
                log("RESUMED %s (%s)" % (label, pane_id), echo=False)
                clear_hibernated(pane_id)
                del state[pane_id]
                remove_stub_file(pane_id)
                save_state(state)
            continue
        if pane.get("agent"):
            if not dry_run:
                forget_record(pane_id, state,
                              "pane reused by agent %s" % pane.get("agent"))
            continue
        if not bare_shell(info):
            log("SKIP restore %s (%s): pane is busy, will retry next pass" % (
                label, pane_id))
            continue

        # Pane is an empty shell but we still owe it a session: re-arm it.
        if dry_run:
            log("WOULD restore %s (%s): stub is dead, session %s" % (
                label, pane_id, rec["uuid"]))
            continue
        write_stub_file(pane_id, rec)
        try:
            herdr("pane", "run", pane_id, stub_command(pane_id))
        except RuntimeError as exc:  # pane vanished mid-sweep; try again later
            log("SKIP restore %s (%s): %s" % (label, pane_id, exc))
            continue
        mark_when_listed(pane_id, rec.get("agent", "claude"))
        tab_id = pane.get("tab_id", rec.get("tab_id", ""))
        cur_label = tab_labels.get(tab_id, "")
        if tab_id and label and not cur_label.startswith("💤"):
            try:
                herdr("tab", "rename", tab_id, "💤 %s" % label)
            except RuntimeError:
                pass
        restored += 1
        log("RESTORED %s (%s): re-armed stub for session %s" % (
            label, pane_id, rec["uuid"]))
    if not dry_run:
        gc_stub_files(state, panes)
    return restored


