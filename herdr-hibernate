def cmd_scan(cfg=None):
    cfg = cfg or load_config()
    dry_run = cfg["DRY_RUN"] != "0"
    self_pane = os.environ.get("HERDR_PANE_ID", "")
    state = load_state()
    panes, tab_labels = collect_panes()
    # Always first: a dead stub (Herdr restart / reboot) must be re-armed before
    # anything else looks at this pane. Restore is never gated by DRY_RUN — it
    # only ever hands panes back the session they already lost.
    restore_records(panes, tab_labels, state,
                    forget_after=float(cfg["FORGET_AFTER_MINUTES"]))

    mode = "DRY-RUN" if dry_run else "LIVE"
    log("--- scan (%s, threshold %sm, %d panes) ---" % (
        mode, cfg["HIBERNATE_AFTER_MINUTES"], len(panes)))
    count = 0
    for pane in panes:
        pane_id = pane["pane_id"]
        label = tab_labels.get(pane.get("tab_id", ""), "") or pane.get("label", "") or "(unnamed)"
        try:
            decision, reason = classify(pane, tab_labels, cfg, state, self_pane)
        except Exception as exc:  # one bad pane must not kill the whole pass
            log("ERROR classifying %s (%s): %s" % (label, pane_id, exc))
            continue
        if decision == "hibernate":
            # One pane must never abort the pass: a tab closed mid-scan makes
            # the herdr call fail, and the remaining panes still need a look.
            try:
                hibernate_pane(pane, tab_labels, cfg, state,
                               reason.replace("idle ", ""), dry_run)
            except Exception as exc:
                log("ERROR hibernating %s (%s): %s" % (label, pane_id, exc))
            count += 1
        elif decision == "exempt":
            log("exempt %s (%s): %s" % (label, pane_id, reason))
        else:
            log("skip   %s (%s): %s" % (label, pane_id, reason))
    log("--- scan done: %d candidate(s)%s ---" % (
        count, " (dry-run, nothing touched)" if dry_run and count else ""))


def cmd_watch():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with file_lock(WATCH_LOCK_FILE, blocking=False) as acquired:
        if not acquired:
            old = watcher_pid()
            detail = " (pid %d)" % old if old else ""
            sys.exit("watch already running%s" % detail)
        with open(PID_FILE, "w") as fh:
            fh.write(str(os.getpid()))
        log("watch started (pid %d)" % os.getpid())
        try:  # a fresh watcher usually means a fresh Herdr: re-arm dead stubs now
            def startup_restore():
                state = load_state()
                if state:
                    panes, tab_labels = collect_panes()
                    restore_records(
                        panes, tab_labels, state,
                        forget_after=float(
                            load_config()["FORGET_AFTER_MINUTES"]))
            run_locked(startup_restore)
        except Exception as exc:
            log("startup restore failed: %s" % exc)
        try:
            while True:
                cfg = load_config()  # re-read each pass so DRY_RUN flips take effect
                try:
                    run_locked(cmd_scan, cfg)
                except Exception as exc:  # keep the loop alive
                    log("scan error: %s" % exc)
                try:
                    maybe_check_update(cfg)
                except Exception as exc:
                    log("update check error: %s" % exc, echo=False)
                time.sleep(float(cfg["SCAN_INTERVAL_SECONDS"]))
        finally:
            try:
                os.remove(PID_FILE)
            except OSError:
                pass


def cmd_now():
    """Hibernate the focused pane right now — what a keybinding calls.

    Runs detached from any pane, so it asks Herdr which pane has focus rather
    than trusting HERDR_PANE_ID. Feedback goes to a Herdr notification, since a
    detached command has nowhere to print.
    """
    log("now: on-demand hibernate requested (PATH=%s)"
        % os.environ.get("PATH", "")[:80], echo=False)
    try:
        pane = herdr("pane", "current").get("pane") or {}
    except RuntimeError as exc:
        toast("Hibernate failed", str(exc)[:120], sound="request")
        sys.exit(1)
    pane_id = pane.get("pane_id") or os.environ.get("HERDR_PANE_ID", "")
    if not pane_id:
        toast("Hibernate failed", "could not tell which pane has focus",
              sound="request")
        sys.exit(1)
    cmd_hibernate(pane_id, force=True, notify=True)


def cmd_hibernate(pane_id, force=False, notify=False):
    """Manual hibernate: bypasses the idle-time threshold, keeps all safety rules.

    `force` additionally skips the just-resumed guard and the background-job
    guard (an explicit request is not a mistake). The guard that refuses to
    kill a pane's own shell always applies — that one would close the tab.
    """
    cfg = load_config()
    dry_run = cfg["DRY_RUN"] != "0"

    def fail(msg):
        if notify:
            toast("Not hibernated", msg[:160], sound="request")
        sys.exit(msg)
    state = load_state()
    panes, tab_labels = collect_panes()
    restore_records(panes, tab_labels, state,
                    forget_after=float(cfg["FORGET_AFTER_MINUTES"]))
    pane = next((p for p in panes if p["pane_id"] == pane_id), None)
    if pane is None:
        fail("no such pane: %s" % pane_id)
    # A key press is aimed at whatever is focused, so never treat the focused
    # pane as "the reaper's own" — that exemption exists for the watcher only.
    self_pane = "" if force else os.environ.get("HERDR_PANE_ID", "")
    decision, reason = classify(pane, tab_labels, cfg, state, self_pane)
    if decision == "exempt":
        fail("refusing: %s" % reason)
    if decision == "skip" and not reason.startswith("idle only"):
        # `--force` may override the background-job guard — an explicit request
        # is not a mistake — but nothing else.
        if force and reason.startswith("busy:"):
            log("force: overriding background-job guard on %s (%s)" % (
                pane_id, reason))
        else:
            fail("cannot hibernate: %s" % reason)
    uuid = session_uuid(pane)
    idle = fmt_idle(transcript_age_minutes(uuid, pane.get("agent", "claude")))
    before = len(state)
    hibernate_pane(pane, tab_labels, cfg, state, idle, dry_run, force=force)
    if dry_run:
        print("(dry-run — set DRY_RUN=0 in %s to hibernate for real)" % CONFIG_FILE)
    elif notify and len(state) == before:
        # hibernate_pane logged the reason and returned without acting.
        fail("hibernate refused — see %s" % LOG_FILE)


def cmd_restore(dry_run=False):
    """Re-arm every hibernated pane whose stub is gone. Safe to run any time."""
    state = load_state()
    if not state:
        print("nothing hibernated")
        return
    panes, tab_labels = collect_panes()
    n = restore_records(panes, tab_labels, state, dry_run=dry_run,
                        forget_after=float(load_config()["FORGET_AFTER_MINUTES"]))
    print("restore: %d pane(s) re-armed, %d hibernated record(s) tracked" % (
        n, len(load_state())))


def cmd_forget(pane_id, resumed=False):
    """Drop a pane's hibernation record and stub (called by the stub on resume)."""
    state = load_state()
    rec = state.pop(pane_id, None)
    save_state(state)
    remove_stub_file(pane_id)
    if rec:
        log("%s %s (%s)" % ("RESUMED" if resumed else "FORGOT",
                            rec.get("label", "?"), pane_id), echo=not resumed)
    elif not resumed:
        print("no hibernation record for %s" % pane_id)


def cmd_label_awake(pane_id):
    """Restore this record's exact tool-owned tab label without clearing state.

    Every stub calls this right before it execs the agent, so it is also where
    the pane's resume stamp is written (see agent_age_minutes).
    """
    write_resume_stamp(pane_id)
    state = load_state()
    rec = state.get(pane_id)
    if not rec:
        return
    clear_hibernated(pane_id)
    try:
        pane = herdr("pane", "get", pane_id).get("pane", {})
    except RuntimeError:
        pane = {"tab_id": rec.get("tab_id", "")}
    if not restore_owned_tab_label(pane_id, pane, rec, state):
        sys.exit(1)


SHELL_HOOK = """%s
# Re-arm a hibernated agent session when Herdr spawns a fresh shell in a pane.
# This is what makes hibernation survive a reboot: the stub process dies with
# Herdr, but its script lives on disk and this hook runs it again.
# Run it as a CHILD (no exec) so this shell stays the pane's shell — claude is
# then a grandchild, and killing it at the next hibernation cannot close the tab.
if [ -n "${HERDR_PANE_ID:-}" ] && [ -z "${HERDR_HIBERNATE_STUB:-}" ] \\
   && [[ $- == *i* ]]; then
    _hb_stub_file="$HOME/.config/herdr-hibernate/panes/${HERDR_PANE_ID//[^A-Za-z0-9]/_}.sh"
    if [ -s "$_hb_stub_file" ]; then
        HERDR_HIBERNATE_STUB=1 bash "$_hb_stub_file"
    fi
    unset _hb_stub_file
fi
# <<< herdr-hibernate pane stub hook <<<
""" % SHELL_HOOK_MARK


def install_shell_hook(rc=os.path.expanduser("~/.bashrc")):
    """Add (or refresh) the .bashrc hook that re-arms stubs in fresh shells."""
    try:
        with open(rc, encoding="utf-8") as fh:
            body = fh.read()
    except OSError:
        body = ""
    if SHELL_HOOK_MARK in body:
        start = body.index(SHELL_HOOK_MARK)
        end = body.index("# <<< herdr-hibernate pane stub hook <<<", start)
        end = body.index("\n", end) + 1
        if body[start:end] == SHELL_HOOK:
            return "shell hook already installed in %s" % rc
        body = body[:start] + SHELL_HOOK + body[end:]
        action = "updated"
    else:
        body = body.rstrip("\n") + "\n\n" + SHELL_HOOK
        action = "installed"
    with open(rc, "w", encoding="utf-8") as fh:
        fh.write(body)
    return "%s shell hook in %s" % (action, rc)


def cmd_status():
    cfg = load_config()
    state = load_state()
    self_pane = os.environ.get("HERDR_PANE_ID", "")
    panes, tab_labels = collect_panes()
    restore_records(panes, tab_labels, state, dry_run=True)
    threshold = cfg["HIBERNATE_AFTER_MINUTES"]
    print("DRY_RUN=%s  threshold=%sm  pin_marker=%s  pinned_tabs=[%s]" % (
        cfg["DRY_RUN"], threshold, cfg["PIN_MARKER"], cfg["PINNED_TABS"]))
    hint = update_hint()
    if hint:
        print(hint)
    print()
    fmt = "%-22s %-28s %-8s %-7s %s"
    print(fmt % ("PANE", "TAB LABEL", "STATUS", "IDLE", "CLASSIFICATION"))
    for pane in panes:
        pane_id = pane["pane_id"]
        label = (tab_labels.get(pane.get("tab_id", ""), "")
                 or pane.get("label", "") or "(unnamed)")[:28]
        agent = pane.get("agent") or ""
        status = pane.get("agent_status", "-") if agent else "-"
        uuid = session_uuid(pane)
        idle = (fmt_idle(transcript_age_minutes(uuid, agent))
                if uuid and agent in AGENTS else "-")
        decision, reason = classify(pane, tab_labels, cfg, state, self_pane)
        tag = {"hibernate": "WOULD HIBERNATE", "exempt": "EXEMPT — " + reason,
               "skip": reason}[decision]
        if decision == "hibernate":
            # Show the guards hibernate_pane applies, so this table cannot
            # promise a kill that would actually be refused.
            try:
                pid, _ = find_agent_proc(pane_id, uuid, agent)
            except RuntimeError:
                pid = None
            if pid:
                info = pane_process_info(pane_id)
                up = proc_uptime_minutes(pid)
                if info and pid == info.get("shell_pid"):
                    tag = "PROTECTED — %s is the pane's shell" % agent
                elif up is not None and up < float(threshold):
                    tag = "PROTECTED — %s started %s ago" % (agent, fmt_idle(up))
        print(fmt % (pane_id, label, status, idle, tag))
    state = load_state()
    if state:
        print("\nhibernated:")
        for pane_id, rec in state.items():
            armed = "stub armed" if stub_alive(pane_process_info(pane_id)) \
                else "STUB DEAD — run `herdr-hibernate restore`"
            print("  %s  %-28s freed ~%dMB at %s  [%s]" % (
                pane_id, rec["label"][:28], rec["freed_mb"], rec["at"], armed))


def watcher_pid():
    """PID of a live watcher, or None. Survives reboots reusing the pid."""
    try:
        pid = int(open(PID_FILE).read().strip())
    except (OSError, ValueError):
        return None
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            if b"herdr-hibernate" in fh.read():
                return pid
    except OSError:
        pass
    return None


def cmd_ensure():
    """Start the watcher if it is not already running (for shell rc hooks)."""
    with file_lock(OPERATION_LOCK_FILE):
        if watcher_lock_active():
            return
        proc = subprocess.Popen(
            [SELF, "watch"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, start_new_session=True)
        deadline = time.time() + 5
        while time.time() < deadline:
            if watcher_lock_active():
                log("ensure: watcher was not running, started pid %d" % proc.pid,
                    echo=False)
                return
            if proc.poll() is not None:
                break
            time.sleep(0.05)
        log("ensure: watcher failed to acquire its lock", echo=False)


