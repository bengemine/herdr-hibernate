def git(*args, timeout=60):
    """stdout of a git command in the plugin's own checkout, or None if it failed."""
    try:
        run = subprocess.run(["git", "-C", REPO_DIR] + list(args),
                             capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return run.stdout.strip() if run.returncode == 0 else None


def plugin_version(rev=None):
    """`version` from herdr-plugin.toml — the working copy, or at a git revision."""
    if rev is None:
        try:
            with open(os.path.join(REPO_DIR, "herdr-plugin.toml")) as fh:
                text = fh.read()
        except OSError:
            return None
    else:
        text = git("show", "%s:herdr-plugin.toml" % rev)
        if text is None:
            return None
    found = re.search(r'^version\s*=\s*"([^"]+)"', text, re.M)
    return found.group(1) if found else None


def upstream_ref():
    """The remote ref to follow: the branch's upstream, else origin's default.

    Herdr installs plugins at a detached commit (no branch), so `@{u}` is not
    enough on its own.
    """
    for ref in ("@{u}", "origin/HEAD", "origin/main", "origin/master"):
        if git("rev-parse", "--verify", "--quiet", ref) is not None:
            return ref
    return None


def commits_behind(ref):
    count = git("rev-list", "--count", "HEAD..%s" % ref)
    try:
        return int(count)
    except (TypeError, ValueError):
        return None


def update_hint():
    """One line if the last fetch saw a newer version, else None. No network."""
    ref = upstream_ref()
    behind = commits_behind(ref) if ref else None
    if not behind:
        return None
    return ("update: %s available (you run %s) — run `herdr-hibernate update` "
            "or the Herdr action \"Hibernate: update plugin\"" % (
                plugin_version(ref) or "a newer version", plugin_version() or "?"))


def maybe_check_update(cfg):
    """Once per UPDATE_CHECK_HOURS: fetch, and announce a newer version.

    Announce only — the watcher never installs anything by itself; a bad
    commit pulled silently would run against every session on the machine.
    """
    try:
        hours = float(cfg.get("UPDATE_CHECK_HOURS", "24"))
    except ValueError:
        hours = 24.0
    if hours <= 0:
        return
    try:
        last = os.stat(UPDATE_CHECK_FILE).st_mtime
    except OSError:
        last = None
    if last is not None and time.time() - last < hours * 3600:
        return
    # Stamp before the fetch: an unreachable origin must not retry every scan.
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(UPDATE_CHECK_FILE, "w") as fh:
        fh.write(time.strftime("%Y-%m-%d %H:%M:%S"))
    if git("fetch", "--quiet", "origin", timeout=120) is None:
        log("update check: could not fetch origin (next try in %gh)" % hours,
            echo=False)
        return
    ref = upstream_ref()
    behind = commits_behind(ref) if ref else None
    if behind is None:
        log("update check: no upstream ref to compare with", echo=False)
        return
    if behind == 0:
        log("update check: up to date (%s)" % (plugin_version() or "?"),
            echo=False)
        return
    local, remote = plugin_version() or "?", plugin_version(ref) or "?"
    log("UPDATE available: %s (you run %s, %d commit%s behind) — run "
        "`herdr-hibernate update` or the Herdr action \"Hibernate: update "
        "plugin\"" % (remote, local, behind, "" if behind == 1 else "s"))
    toast("Herdr Hibernate %s available" % remote,
          "You run %s. Run the Herdr action \"Hibernate: update plugin\" "
          "(or: herdr-hibernate update)." % local)


def cmd_update(pull_only=False):
    """Bring the plugin's own checkout up to date, then hand over to the new code.

    Works for both install shapes: a branch checkout (`git clone`) is
    fast-forwarded; Herdr's managed install sits on a detached commit and is
    moved to the remote's head. Never rewrites local changes.
    """
    if git("rev-parse", "--is-inside-work-tree") is None:
        sys.exit("%s is not a git checkout — reinstall with:\n"
                 "  herdr plugin install bengemine/herdr-hibernate --yes" % REPO_DIR)
    if git("status", "--porcelain", "--untracked-files=no"):
        sys.exit("local changes in %s would be overwritten — commit or stash "
                 "them first" % REPO_DIR)
    before, old_version = git("rev-parse", "HEAD") or "?", plugin_version() or "?"
    print("checking %s for updates..." % REPO_DIR)
    if git("fetch", "--quiet", "origin", timeout=120) is None:
        sys.exit("git fetch failed — is GitHub reachable?")
    ref = upstream_ref()
    if ref is None:
        sys.exit("no remote branch to follow (expected origin/main)")
    if git("symbolic-ref", "-q", "HEAD") is not None:
        moved = git("merge", "--ff-only", ref)
    else:
        moved = git("checkout", "--quiet", "--detach", ref)
    if moved is None:
        sys.exit("could not move to %s — run `git -C %s status` to see why"
                 % (ref, REPO_DIR))
    after = git("rev-parse", "HEAD") or "?"
    if pull_only:
        print("%s -> %s (version %s -> %s); watcher not restarted (--pull-only)"
              % (before[:7], after[:7], old_version, plugin_version() or "?"))
        return
    # Everything after the pull runs from the NEW script (restart + re-link
    # logic may itself have changed), so re-exec rather than continue here.
    os.execv(SELF, [SELF, "_apply-update", old_version, before[:7]])


def restart_watcher():
    """Restart a running watcher so it executes the freshly pulled code."""
    if os.path.exists(SYSTEMD_UNIT) and systemd_available():
        run = subprocess.run(["systemctl", "--user", "restart",
                              "herdr-hibernate.service"],
                             capture_output=True, text=True)
        return ("restarted (systemd user service)" if run.returncode == 0
                else "systemd restart failed: %s" % run.stderr.strip())
    pid = watcher_pid()
    if not pid:
        return "not running — nothing to restart (run `install` to start it)"
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.time() + 10
    while time.time() < deadline and watcher_lock_active():
        time.sleep(0.1)
    if watcher_lock_active():
        return "old watcher (pid %d) did not stop; not restarted" % pid
    cmd_ensure()
    new = watcher_pid()
    return "restarted (pid %d -> %d)" % (pid, new) if new else "stopped, but the new watcher failed to start"


def refresh_registry():
    """Re-link so Herdr sees the new version and any new actions (best effort)."""
    try:
        subprocess.run([herdr_bin(), "plugin", "link", REPO_DIR], check=True,
                       capture_output=True, text=True, timeout=30)
        return "re-linked (new version and actions visible in Herdr)"
    except (RuntimeError, OSError, subprocess.CalledProcessError,
            subprocess.TimeoutExpired):
        return ("could not re-link — run: herdr plugin link %s" % REPO_DIR)


def cmd_apply_update(old_version="?", old_rev="?"):
    """Second half of `update`, running on the freshly pulled code."""
    new_version = plugin_version() or "?"
    new_rev = (git("rev-parse", "HEAD") or "?")[:7]
    load_config()  # append any config keys this version introduced
    if old_rev == new_rev:
        print("already up to date (version %s)" % new_version)
    else:
        print("updated %s -> %s (%s -> %s)" % (old_version, new_version,
                                               old_rev, new_rev))
    print("watcher: %s" % restart_watcher())
    print("herdr registry: %s" % refresh_registry())
    try:
        os.utime(UPDATE_CHECK_FILE)  # a fresh update needs no check for a day
    except OSError:
        pass
    log("UPDATED plugin %s -> %s (%s -> %s)" % (old_version, new_version,
                                                old_rev, new_rev), echo=False)
    if old_rev != new_rev:
        toast("Herdr Hibernate updated", "%s -> %s" % (old_version, new_version))


def systemd_available():
    try:
        return subprocess.run(["systemctl", "--user", "status"],
                              capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def cmd_install():
    self_path = SELF
    print(install_shell_hook())
    if systemd_available():
        os.makedirs(os.path.dirname(SYSTEMD_UNIT), exist_ok=True)
        env_lines = "".join(
            'Environment="%s=%s"\n' % (k, os.environ[k])
            for k in ("HERDR_ENV", "HERDR_WORKSPACE_ID", "HERDR_TAB_ID", "HERDR_PANE_ID")
            if k in os.environ)
        with open(SYSTEMD_UNIT, "w") as fh:
            fh.write("[Unit]\nDescription=herdr-hibernate idle-tab reaper\n\n"
                     "[Service]\nExecStart=%s watch\nRestart=on-failure\n%s\n"
                     "[Install]\nWantedBy=default.target\n" % (self_path, env_lines))
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now",
                        "herdr-hibernate.service"], check=True)
        print("installed systemd user service: herdr-hibernate.service")
        return
    # WSL2 fallback: detached nohup loop inheriting this pane's Herdr env.
    old = watcher_pid()
    if old:
        sys.exit("already installed and running (pid %d)" % old)
    proc = subprocess.Popen(
        ["nohup", self_path, "watch"],
        stdout=open(os.devnull, "w"), stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL, start_new_session=True)
    print("systemd user units unavailable — started nohup watcher (pid %d)." % proc.pid)
    print("It inherits this pane's Herdr env; re-run install after a Herdr restart.")
    print("Log: %s" % LOG_FILE)


def cmd_uninstall():
    stopped = False
    if os.path.exists(SYSTEMD_UNIT):
        subprocess.run(["systemctl", "--user", "disable", "--now",
                        "herdr-hibernate.service"], capture_output=True)
        os.remove(SYSTEMD_UNIT)
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        print("removed systemd user service")
        stopped = True
    if os.path.exists(PID_FILE):
        try:
            pid = int(open(PID_FILE).read().strip())
            if os.path.exists("/proc/%d" % pid):
                os.kill(pid, signal.SIGTERM)
                print("stopped watcher (pid %d)" % pid)
                stopped = True
        except (ValueError, ProcessLookupError):
            pass
        try:
            os.remove(PID_FILE)
        except OSError:
            pass
    if not stopped:
        print("nothing to uninstall")


def main():
    if os.environ.get("HERDR_ENV") != "1" and "HERDR_PANE_ID" not in os.environ:
        # herdr CLI may still reach the session, but warn: self-pane exemption
        # cannot work without HERDR_PANE_ID.
        print("warning: not inside a Herdr-managed pane (HERDR_ENV != 1)",
              file=sys.stderr)
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip())
        sys.exit(2)
    cmd = args[0]
    if cmd == "watch":
        cmd_watch()
    elif cmd == "scan":
        run_locked(cmd_scan)
    elif cmd == "hibernate":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate hibernate <pane_id> [--force]")
        run_locked(cmd_hibernate, args[1], force="--force" in args)
    elif cmd == "now":
        run_locked(cmd_now)
    elif cmd == "restore":
        run_locked(cmd_restore, dry_run="--dry-run" in args)
    elif cmd == "forget":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate forget <pane_id> [--resumed]")
        run_locked(cmd_forget, args[1], resumed="--resumed" in args)
    elif cmd == "label-awake":
        if len(args) < 2:
            sys.exit("usage: herdr-hibernate label-awake <pane_id>")
        run_locked(cmd_label_awake, args[1])
    elif cmd == "status":
        cmd_status()
    elif cmd == "ensure":
        cmd_ensure()
    elif cmd == "install":
        cmd_install()
    elif cmd == "uninstall":
        cmd_uninstall()
    elif cmd == "update":
        cmd_update(pull_only="--pull-only" in args)
    elif cmd == "_apply-update":
        cmd_apply_update(*args[1:3])
    else:
        sys.exit("unknown command: %s\n%s" % (cmd, __doc__.strip()))


if __name__ == "__main__":
    main()
